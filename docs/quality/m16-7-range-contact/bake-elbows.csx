// Offline studio snippet for Unity MCP script-execute (isMethodBody=true).
// Reads the current imported rig and versioned motion definition. Writes scratch
// guide vectors only; merge the result into performance-motion-v1.json, refresh,
// then run all range anatomy/contact/continuity and scrub regressions.
// No race objects, mesh baking, collision simulation or online randomness.
using System;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Globalization;using System.IO;using UnityEngine;using UnityEditor;using Biathlon.Unity.Presentation;using Object=UnityEngine.Object;
var r=Object.Instantiate(AssetDatabase.LoadAssetAtPath<GameObject>("Assets/Biathlon/Characters/Biathlete_16_7/Prefabs/Biathlete_16_7_Natural.prefab")).GetComponent<Biathlete167Rig>();var m=r.gameObject.AddComponent<Biathlete167Motion>();m.Initialize(r,true);var ty=typeof(Biathlete167SportMotion);var forced=ty.GetField("authoringRightElbowGuide",BindingFlags.Instance|BindingFlags.NonPublic);var d=ty.GetField("d",BindingFlags.Instance|BindingFlags.NonPublic).GetValue(m.Performance);var rows=new List<string>();var curves=new List<string>();var ci=CultureInfo.InvariantCulture;
try{foreach(var action in new[]{Biathlete167Action.EnterStanding,Biathlete167Action.EnterProne}){forced.SetValue(m.Performance,null);m.EvaluateAction(action,0);var upper=r.Bone(HumanBodyBones.RightUpperArm);var elbow=r.Bone(HumanBodyBones.RightLowerArm);var previous=r.transform.InverseTransformVector(elbow.position-upper.position);var points=new List<Vector3>();float max=0;
for(int i=0;i<=512;i++){forced.SetValue(m.Performance,previous);m.EvaluateAction(action,i/512f);var now=r.transform.InverseTransformVector(elbow.position-upper.position);max=Mathf.Max(max,Vector3.Distance(now,previous));points.Add(now);previous=now;}
string name=action==Biathlete167Action.EnterStanding?"standing_right_elbow_curve":"prone_right_elbow_curve";d.GetType().GetField(name).SetValue(d,points.ToArray());curves.Add("\""+name+"\":["+string.Join(",",points.Select(v=>"{\"x\":"+v.x.ToString("R",ci)+",\"y\":"+v.y.ToString("R",ci)+",\"z\":"+v.z.ToString("R",ci)+"}"))+"]");rows.Add(action+" max adjacent guide step "+max);}
forced.SetValue(m.Performance,null);File.WriteAllText("artifacts/m16-7-range-contact-20261107/elbow-curves.json","{"+string.Join(",\n",curves)+"}\n");return string.Join("\n",rows);}finally{Object.DestroyImmediate(r.gameObject);}
